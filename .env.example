# Discord application token and private allowlists.
PICO_DISCORD_BOT_TOKEN=
PICO_CHANNEL_ID=
DISCORD_USER_ID=
DISCORD_CHANNEL_ID=
# Optional: sync application commands to one development server.
DISCORD_GUILD_ID=

# Optional Reddit script-app credentials. Leave both blank for direct-image-only mode.
PICO_REDDIT_CLIENT_ID=
PICO_REDDIT_CLIENT_SECRET=
# Required only when Reddit credentials are configured.
PICO_REDDIT_USER_AGENT=pico-photo-bot/0.1 by u/your-reddit-account

# Optional fallback research for webpage photos missing publisher credits.
OPENROUTER_API_KEY=
PICO_OPENROUTER_MODEL=openai/gpt-5-nano

# One to 25 comma-separated Google Photos album titles.
PICO_ALBUM_NAMES=Album One,Album Two

# Stable deployment marker: picoarc plus 12 hexadecimal characters. Never change after uploads exist.
PICO_ARCHIVE_SEARCH_TAG=picoarc0123456789ab

# Local persistent paths.
PICO_DATA_PATH=data/pico.db
PICO_MEDIA_PATH=data/pico-media
PICO_GOOGLE_CREDENTIALS_PATH=data/google-photos-credentials.json
PICO_GOOGLE_TOKEN_PATH=data/google-photos-token.json

# Coolify only: base64 copies used to seed the persistent volume.
PICO_GOOGLE_CREDENTIALS_BASE64=
PICO_GOOGLE_TOKEN_BASE64=

LOG_LEVEL=INFO
